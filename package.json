{
  "name": "healthapp",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-navigation/drawer": "^7.9.4",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.100.1",
    "base64-arraybuffer": "^1.0.2",
    "date-fns": "^4.1.0",
    "expo": "~55.0.12",
    "expo-camera": "~55.0.14",
    "expo-crypto": "^55.0.14",
    "expo-device": "~55.0.14",
    "expo-document-picker": "~55.0.12",
    "expo-image-picker": "~55.0.17",
    "expo-linking": "~55.0.11",
    "expo-local-authentication": "~55.0.12",
    "expo-notifications": "~55.0.17",
    "expo-router": "~55.0.11",
    "expo-secure-store": "~55.0.12",
    "expo-status-bar": "~55.0.5",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.14",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.4",
    "react-native-gesture-handler": "^2.30.1",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.7.2"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.2.2",
    "typescript": "~5.9.2"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "@testing-library/jest-native/extend-expect"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|expo-router|@testing-library|react-navigation|@react-navigation|react-native-reanimated|react-native-svg|react-native-screens|react-native-safe-area-context|date-fns|@supabase))"
    ],
    "moduleNameMapper": {
      "^react-native-svg$": "<rootDir>/__mocks__/react-native-svg.js",
      "^expo-router$": "<rootDir>/__mocks__/expo-router.js",
      "^@react-native-async-storage/async-storage$": "<rootDir>/__mocks__/async-storage.js",
      "^@react-native-community/datetimepicker$": "<rootDir>/__mocks__/datetimepicker.js",
      "^expo-secure-store$": "<rootDir>/__mocks__/expo-secure-store.js",
      "^react-native-url-polyfill/auto$": "<rootDir>/__mocks__/url-polyfill.js",
      "^@supabase/supabase-js$": "<rootDir>/__mocks__/supabase-js.js"
    },
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "app/**/*.{ts,tsx}",
      "!**/*.d.ts"
    ]
  }
}
